#include <windows.h>
#include "resource.h"

IDI_LOGO ICON "../branding/logo.ico"

IDD_OPTIONS DIALOGEX 0, 0, 360, 176
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cursor Usage"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_INTERVAL_LABEL, 12, 14, 220, 16, SS_CENTERIMAGE
    EDITTEXT        IDC_INTERVAL, 236, 14, 48, 16, ES_LEFT | ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "", IDC_INTERVAL_HINT, 12, 36, 336, 28
    CONTROL         "", IDC_SHOW_DECIMAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 70, 336, 14
    CONTROL         "", IDC_HIDE_PERCENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 90, 336, 14
    CONTROL         "", IDC_SEPARATE_SPACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 110, 336, 14
    DEFPUSHBUTTON   "OK", IDOK, 242, 142, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 298, 142, 50, 16
END

IDD_OPTIONS_CLASSIC DIALOGEX 0, 0, 340, 164
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cursor Usage"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_INTERVAL_LABEL, 10, 12, 210, 10
    EDITTEXT        IDC_INTERVAL, 224, 10, 44, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "", IDC_INTERVAL_HINT, 10, 28, 320, 24
    CONTROL         "", IDC_SHOW_DECIMAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 56, 320, 12
    CONTROL         "", IDC_HIDE_PERCENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 74, 320, 12
    CONTROL         "", IDC_SEPARATE_SPACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 92, 320, 12
    DEFPUSHBUTTON   "OK", IDOK, 220, 128, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 276, 128, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Cursor usage plugin for TrafficMonitor"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "CursorUsageMonitor"
            VALUE "OriginalFilename", "CursorUsageMonitor.dll"
            VALUE "ProductName", "CursorUsageMonitor"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
